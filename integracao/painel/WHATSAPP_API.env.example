# Copie estas variáveis para C:\Sonifarma\integracao\painel\.env.
# Nunca publique o .env real nem envie tokens no chat.
WHATSAPP_ENABLED=false
# Informe uma versão Graph suportada pela aplicação da Meta (formato vNN.N).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Gere um valor aleatório próprio; ele será usado na verificação do webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
